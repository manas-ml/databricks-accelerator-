# Copy this file to terraform.tfvars and fill in your values.
# Never commit terraform.tfvars — it is gitignored.

project     = "accel"
environment = "uat"
aws_region  = "us-east-1"

availability_zones   = ["us-east-1a", "us-east-1b"]
vpc_cidr             = "10.1.0.0/16"
public_subnet_cidrs  = ["10.1.0.0/24", "10.1.1.0/24"]
private_subnet_cidrs = ["10.1.16.0/20", "10.1.32.0/20"]

databricks_account_id    = "REPLACE_WITH_YOUR_ACCOUNT_ID"
databricks_client_id     = "REPLACE_WITH_SP_CLIENT_ID"
databricks_client_secret = "REPLACE_WITH_SP_CLIENT_SECRET"

# UAT reuses the metastore created for dev (one metastore per AWS region)
create_metastore      = false
existing_metastore_id = "REPLACE_WITH_DEV_METASTORE_ID"

alert_emails     = ["your-team@example.com"]
aws_secret_names = []
kms_key_arn      = ""
